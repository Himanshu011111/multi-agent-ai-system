# Application Configuration
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Google Gemini API Key (Mandatory for AI Agents & LLM Reasoning)
GEMINI_API_KEY=your_google_gemini_api_key_here

# External Search API (Optional - defaults to mock/DuckDuckGo fallback if not provided)
TAVILY_API_KEY=your_tavily_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./data/multi_agent_system.db

# Vector Store Directory
CHROMA_DB_DIR=./data/chroma_db
